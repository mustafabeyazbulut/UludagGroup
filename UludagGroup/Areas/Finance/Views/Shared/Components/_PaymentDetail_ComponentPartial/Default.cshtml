@model List<PaymentDetailViewModel>

<style>
    /* Alternatif satır renkleri için */
    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f8f9fa;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #e9ecef;
    }

    .btn-action {
        width: 100px;
        margin-right: 5px;
    }

    .table th, .table td {
        vertical-align: middle;
    }
</style>
<h3 class="text-center fw-bold mb-4" style="color: #343a40;">Ödemeler Tablosu</h3>


<table id="xTable"
       class="table table-striped"
       data-toolbar="#ToolbarPaymentDetail"
       data-locale="tr-TR"
       data-toggle="table"
       data-show-fullscreen="true"
       data-search="true"
       data-pagination="true"
       data-page-size="10"
       data-mobile-responsive="true"
       data-animation="true"
       data-check-on-init="true"
       data-show-columns="true"
       data-detail-view="true"
       data-show-export="false"
       data-show-footer="true"
       data-detail-formatter="detailFormatter"
       data-minimum-count-columns="2"
       data-id-field="id"
       data-page-list="[10, 25, 50, 100, all]">
    <thead class="table-dark">
        <tr class="text-center">
            <th data-width="100" data-align="center" data-field="actions">İşlemler</th>
            <th data-width="120" data-align="center" data-field="PaymentDate">Tarih</th>
            <th data-align="center" data-field="Amount" data-visible="true">Ödenen Miktar</th>
            <th data-align="center" data-field="Method" data-visible="true">Ödeme Şekli</th>
            <th data-align="center" data-field="Notes" data-visible="true">Not</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var payment in Model)
        {
            <tr>
                <td class="text-center">
                    <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Seç
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" href="@Url.Action("EditPayment", "FinancialTracking", new { area="finance", id = payment.Id,customerId=payment.CustomerId })">
                                <i class="fa fa-edit"></i> Düzenle
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item text-danger" href="@Url.Action("RemovePayment", "FinancialTracking", new {area="finance", id = payment.Id,customerId=payment.CustomerId })" onclick="return confirm('Bu siparişi silmek istediğinizden emin misiniz?')">
                                <i class="fa fa-trash"></i> Sil
                            </a>
                        </li>
                    </ul>
                </td>

                <td>@payment.PaymentDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>@payment.Amount.ToString("C", new System.Globalization.CultureInfo("tr-TR"))</td>
                <td>@payment.Method</td>
                <td>@payment.Notes</td>
            </tr>
        }
    </tbody>
</table>
<script>
        function detailFormatter(index, row) {
        var html = [];
        html.push('<p><strong>Not:</strong> ' + row.Notes + '</p>');

        // Burada siparişler ve ödemeler gibi diğer detayları da ekleyebilirsiniz.

        return html.join('');
    }

    function sumFormatter(data) {
        var field = this.field; // Bu kolonun adı: RemainingBalance
        var total = data.map(row => parseFloat(row[field]) || 0).reduce((sum, i) => sum + i, 0);
        return total.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
    }
         function total() {
        return "Toplam";
    }

</script>
