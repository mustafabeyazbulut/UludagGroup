@model List<PaymentDetailViewModel>
<style>
   

    /* Başlık stili */
    h3 {
        font-weight: 900;
        color: #212529;
        letter-spacing: 1.2px;
        text-shadow: 0 1px 1px rgba(0,0,0,0.05);
    }

    /* Tablo kapsayıcı, gölge ve yuvarlak köşe */
    .table-responsive {
        box-shadow: 0 8px 24px rgba(0,0,0,0.12);
        border-radius: 1rem;
        overflow: hidden;
        background: #ffffff;
        padding: 1.5rem;
    }

    /* Tablo genel ayar */
    table.table {
        border-collapse: separate !important;
        border-spacing: 0 0.8rem;
        font-size: 1rem;
        font-weight: 500;
    }

    /* Tablo başlıkları */
    thead.table-dark th {
        background-color: #343a40 !important;
        color: #f8f9fa !important;
        font-size: 1.05rem;
        letter-spacing: 0.8px;
        border: none !important;
        padding: 1rem 1.5rem;
        text-align: center;
    }

    /* Tablo gövdesi satırları (yuvarlak kart görünümü) */
    tbody tr {
        background: linear-gradient(90deg, #ffffff 0%, #f9fafb 100%);
        box-shadow: 0 3px 10px rgba(0,0,0,0.08);
        border-radius: 0.8rem;
        transition: all 0.3s ease;
        cursor: pointer;
        vertical-align: middle !important;
    }

        /* Satır hover efekti */
        tbody tr:hover {
            background: linear-gradient(90deg, #e3f2fd 0%, #bbdefb 100%);
            box-shadow: 0 8px 20px rgba(33, 150, 243, 0.4);
            transform: translateY(-3px);
            font-weight: 600;
        }

        /* Satır seçildiğinde */
        tbody tr.selected {
            background: #1976d2;
            color: white;
            box-shadow: 0 8px 24px rgba(25, 118, 210, 0.7);
            font-weight: 700;
        }

    /* Hücre ayarları */
    tbody td {
        padding: 1rem 1.5rem !important;
        text-align: center;
        vertical-align: middle !important;
    }

    /* Para formatı özel renk */
    .amount-cell {
        font-weight: 700;
        color: #007bff;
        font-size: 1.1rem;
        text-shadow: 0 1px 2px rgba(0,123,255,0.3);
    }

    /* Not hücresi için italik ve gri */
    .note-cell {
        font-style: italic;
        color: #6c757d;
    }

    /* Butonlar */
    .btn.confirm-btn {
        background: linear-gradient(45deg, #4caf50, #2e7d32);
        border: none;
        box-shadow: 0 6px 12px rgba(46,125,50,0.5);
        font-weight: 600;
        border-radius: 0.5rem;
        padding: 0.6rem 1.4rem;
        transition: all 0.3s ease;
        color: white;
    }

        .btn.confirm-btn:hover {
            background: linear-gradient(45deg, #66bb6a, #388e3c);
            box-shadow: 0 8px 18px rgba(56,142,60,0.7);
            transform: scale(1.05);
        }

   
</style>
<div class=" py-1">
    <h3 class="text-center fw-bold mb-4">Ödemeler Tablosu</h3>

    <div class="table-responsive shadow-sm">
        <table id="xTable"
               class="table table-striped table-hover"
               data-toolbar="#ToolbarPaymentDetail"
               data-locale="tr-TR"
               data-toggle="table"
               data-show-fullscreen="true"
               data-search="true"
               data-pagination="true"
               data-page-size="10"
               data-mobile-responsive="true"
               data-animation="true"
               data-check-on-init="true"
               data-show-columns="true"
               data-detail-view="true"
               data-show-export="false"
               data-show-footer="true"
               data-detail-formatter="detailFormatter"
               data-minimum-count-columns="2"
               data-id-field="id"
               data-page-list="[10, 25, 50, 100, all]">
            <thead class="table-dark">
                <tr class="text-center">
                    <th data-width="150" data-align="center" data-field="PaymentDate">Tarih</th>
                    <th data-width="250" data-align="center" data-field="Amount" data-visible="true">Ödenen Miktar</th>
                    <th data-width="300" data-align="center" data-field="Notes" data-visible="true">Not</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var payment in Model)
                {
                    <tr class="clickable-row" data-href="@Url.Action("EditPayment", "FinancialTracking", new { area = "finance", id = payment.Id, customerId = payment.CustomerId })">
                        <td>@payment.PaymentDate.ToString("dd.MM.yyyy HH:mm")</td>
                        <td class="amount-cell">@payment.Amount.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                        <td class="note-cell">@payment.Notes</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<script>
        function detailFormatter(index, row) {
        var html = [];
        html.push('<p><strong>Not:</strong> ' + row.Notes + '</p>');

        // Burada siparişler ve ödemeler gibi diğer detayları da ekleyebilirsiniz.

        return html.join('');
    }

    function sumFormatter(data) {
        var field = this.field; // Bu kolonun adı: RemainingBalance
        var total = data.map(row => parseFloat(row[field]) || 0).reduce((sum, i) => sum + i, 0);
        return total.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
    }
         function total() {
        return "Toplam";
    }

</script>
