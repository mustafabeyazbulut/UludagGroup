@model List<OrderDetailViewModel>
<style>
    /* 🌈 Genel tablo görünümü */
    table.table {
        border-collapse: separate !important;
        border-spacing: 0 0.6rem;
    }

    /* 🟥 Hizmet: Koyu kırmızı - beyaz yazı */
    .item-service {
        background: linear-gradient(to right, #dc3545, #c82333);
        color: #fff !important;
        font-weight: 600;
        box-shadow: 0 0 6px rgba(220, 53, 69, 0.4);
        border-radius: 0.5rem;
    }

    /* 🟩 Ürün: Koyu yeşil - beyaz yazı */
    .item-product {
        background: linear-gradient(to right, #198754, #157347);
        color: #fff !important;
        font-weight: 600;
        box-shadow: 0 0 6px rgba(25, 135, 84, 0.4);
        border-radius: 0.5rem;
    }

        /* 🧱 Satır içeriği */
        .item-service td,
        .item-product td {
            padding: 1rem !important;
            font-size: 1.05rem;
            vertical-align: middle;
        }

    /* 🖱️ Hover efekti dış tablo için */
    .clickable-row:hover {
        cursor: pointer;
        background-color: #f1f3f5 !important;
        transition: background 0.3s ease-in-out;
    }

    /* 🟦 İç tablo başlığı */
    .order-table-inner thead th {
        background-color: #343a40;
        color: #fff;
        font-size: 0.95rem;
    }

    /* 📦 Dış tablo başlığı */
    .table-dark th {
        background-color: #212529 !important;
        color: #f8f9fa !important;
        letter-spacing: 0.5px;
    }

    /* 🖋️ Genel yazı ayarı */
    .table td, .table th {
        text-align: center;
        vertical-align: middle;
    }

    /* 🧤 Buton görsel */
    .btn.confirm-btn {
        box-shadow: 0 4px 6px rgba(0, 128, 0, 0.3);
        font-weight: 500;
        border-radius: 0.4rem;
    }
</style>



<h3 class="text-center fw-bold mb-4" style="color: #343a40;">Siparişler Tablosu</h3>

<table id="xTable"
       class="table table-striped"
       data-toolbar="#ToolbarOrderDetail"
       data-locale="tr-TR"
       data-toggle="table"
       data-show-fullscreen="true"
       data-search="true"
       data-pagination="true"
       data-page-size="10"
       data-mobile-responsive="true"
       data-animation="true"
       data-check-on-init="true"
       data-show-columns="true"
       data-detail-view="true"
       data-show-export="false"
       data-show-footer="true"
       data-detail-formatter="detailFormatter"
       data-minimum-count-columns="2"
       data-id-field="id"
       data-page-list="[10, 25, 50, 100, all]">
    <thead class="table-dark">
        <tr class="text-center">
            <th data-width="120" data-align="center" >Servis Formu</th>
            <th data-width="120" data-align="center" data-field="OrderDate">Tarih</th>
            <th data-align="center" data-field="OrderItems" data-visible="true">İçerik</th>
            <th data-align="center" data-field="Notes" data-visible="false">Not</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr class="clickable-row" data-href="@Url.Action("EditOrder", "FinancialTracking", new { area = "finance", id = order.Id, customerId = order.CustomerId })">
                <td>
                    <button type="button"
                            class="btn btn-success confirm-btn"
                            data-url="@Url.Content("~/finance/FinancialTracking/SendDocument")?orderId=@order.Id&customerId=@order.CustomerId">
                        Gönder
                    </button>
                </td>
                <td>@order.OrderDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <table id="xTable2" class="table table-bordered table-hover order-table-inner">
                        <thead class="table-dark">
                            <tr class="text-center">
                                <th>Tip</th>
                                <th>Adı</th>
                                <th>Not</th>
                                <th>Fiyat</th>
                                <th>Miktar</th>
                                <th>Toplam</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var orderItem in order.OrderItems)
                            {
                                var itemClass = orderItem.ItemType == "Service"
                                ? "item-service"
                                : orderItem.ItemType == "Product"
                                ? "item-product"
                                : "";

                                var iconHtml = orderItem.ItemType == "Service"
                                ? "<i class='fa fa-tools me-1'></i>"
                                : orderItem.ItemType == "Product"
                                ? "<i class='fa fa-box me-1'></i>"
                                : "";

                                <tr class="@itemClass">
                                    <td>@Html.Raw(iconHtml) @(orderItem.ItemType == "Service" ? "Hizmet" : "Ürün")</td>
                                    <td>@orderItem.ItemName</td>
                                    <td>@orderItem.Note</td>
                                    <td>@orderItem.UnitPrice.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                    <td>@orderItem.Quantity</td>
                                    <td>@orderItem.LineTotal.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                                </tr>
                            }


                        </tbody>
                    </table>
                </td>
                <td>@order.Notes</td>
            </tr>
        }
    </tbody>
</table>
<script>
        function detailFormatter(index, row) {
        var html = [];
        html.push('<p><strong>Not:</strong> ' + row.Notes + '</p>');

        // Burada siparişler ve ödemeler gibi diğer detayları da ekleyebilirsiniz.

        return html.join('');
    }

    function sumFormatter(data) {
        var field = this.field; // Bu kolonun adı: RemainingBalance
        var total = data.map(row => parseFloat(row[field]) || 0).reduce((sum, i) => sum + i, 0);
        return total.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
    }
         function total() {
        return "Toplam";
    }
   
</script>
