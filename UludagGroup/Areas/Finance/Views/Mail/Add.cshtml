@model CreateMailViewModel
@{
    ViewData["Title"] = "Add";
    Layout = "~/Areas/Finance/Views/FinanceLayout/Index.cshtml";
}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <h1 class="mb-4 card-title">Yeni Mail göndericisi ekleme alanıdır.</h1>
                @using (Html.BeginForm(
                actionName: "SaveAdd",
                controllerName: "Mail",
                routeValues: new { area = "Finance" },
                method: FormMethod.Post,
                antiforgery: false,
                htmlAttributes: new { @class = "", enctype = "multipart/form-data" }))
                {
                    <div class="row mb-3">
                        <label for="Mail" class="col-sm-2 col-form-label">Mail</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(model => model.Mail, new { @class = "form-control", type = "email", placeholder = "Mail Adresi" })
                        </div>
                    </div>

                    <div class="row mb-3">
                        <label for="Password" class="col-sm-2 col-form-label">Parola</label>
                        <div class="col-sm-10">
                            @Html.PasswordFor(model => model.Password, new { @class = "form-control", placeholder = "Parola", data_val = "false" })
                        </div>
                    </div>

                    <div class="row mb-3 mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-lg btn-primary me-2">Kaydet</button>
                            <a href="@Url.Action("Index", "Mail", new { area = "Finance" })" class="btn btn-lg btn-secondary">Geri Dön</a>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

