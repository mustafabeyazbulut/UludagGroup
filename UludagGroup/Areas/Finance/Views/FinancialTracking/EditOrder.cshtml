@model OrderDetailViewModel
@{
    ViewData["Title"] = "EditOrder";
    Layout = "~/Areas/Finance/Views/FinanceLayout/Index.cshtml";
    var productsHtml = string.Join("", ((List<SelectListItem>)ViewBag.Products).Select(p => $"<option value='{p.Value}'>{p.Text}</option>"));
    var servicesHtml = string.Join("", ((List<SelectListItem>)ViewBag.Services).Select(s => $"<option value='{s.Value}'>{s.Text}</option>"));
    var initialItemCount = Model.OrderItems?.Count ?? 0;
}
<style>
    #ImageUrl {
        cursor: pointer;
    }
</style>
<div class="row justify-content-center">
    <div class="col-lg-12">
        <div class="card">
            <div class="card-body">
                <h1 class="mb-4 card-title">Sipariş Bilgilerini Güncelleyebilirsiniz.</h1>
                @using (Html.BeginForm(
                actionName: "SaveEditOrder",
                controllerName: "FinancialTracking",
                routeValues: new { area = "Finance" },
                method: FormMethod.Post,
                antiforgery: false,
                htmlAttributes: new { @class = "", enctype = "multipart/form-data" }))
                {
                    <div class="row mb-3">
                        @* <label for="Name" class="col-sm-2 col-form-label">Id</label> *@
                        <div class="col-sm-10">
                            <input type="hidden" asp-for="Id" />
                            <input type="hidden" asp-for="CustomerId" />
                            <input type="hidden" asp-for="CustomerName" />
                            @* <label class="form-control" id="Id" asp-for="Id">@Model.Id </label> *@
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Firma Adı</label>
                        <div class="col-sm-10">
                            <label class="form-control" for="CustomerName">@Model.CustomerName</label>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Not</label>
                        <div class="col-sm-10">
                            @Html.TextBoxFor(model => model.Notes, new { @class = "form-control", type = "text", placeholder = "Not", data_val = "false" })
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Senet Fotosunu Seç</label>
                        <div class="col-sm-10">
                            <input type="file" class="form-control" id="ImageFile" asp-for="ImageFile" accept=".jpg, .jpeg, .png" onchange="previewImage(this, 'ImageUrl')" data-val="false">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <label for="Name" class="col-sm-2 col-form-label">Senet Fotoğrafı</label>
                        <div class="col-sm-10">
                            <img id="ImageUrl" src="~/Photos/Documents/@Model.ImageUrl" class="form-control" style="width:200px;height:200px">
                        </div>
                    </div>
                    <button type="button" class="btn btn-success mb-3" id="btn-add-item">+ Yeni Ürün/Hizmet Ekle</button>
                    <h4>Ürün / Hizmetler</h4>
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th style="width: 15%;">Tip</th>
                                <th style="width: 25%;">Ürün / Hizmet</th>
                                <th style="width: 20%;">Birim Fiyat</th>
                                <th style="width: 10%;">Miktar</th>
                                <th style="width: 25%;">Not</th>
                                <th style="width: 5%;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="order-items-container">
                            @for (int i = 0; i < Model.OrderItems.Count; i++)
                            {
                                <tr class="order-item" @(Model.OrderItems[i].IsVisible ? "" : "style=display:none")>
                                    <td>

                                        <input type="hidden" asp-for="OrderItems[i].Id" />
                                        <input type="hidden" name="OrderItems[@i].IsVisible" value="true" class="is-visible-field" />

                                        @Html.DropDownList(
                                                 $"OrderItems[{i}].ItemType",
                                                 new SelectList(new[]
                                                 {
                                new { Text = "Ürün", Value = "Product" },
                                new { Text = "Servis", Value = "Service" }
                                }, "Value", "Text", Model.OrderItems[i].ItemType),
                                                 new { @class = "form-select item-type-select" }
                                                 )

                                    </td>
                                    <td>
                                        @if (Model.OrderItems[i].ItemType == "Product")
                                        {
                                            @Html.DropDownListFor(m => m.OrderItems[i].ItemId,
                                                     new SelectList(ViewBag.Products, "Value", "Text", Model.OrderItems[i].ItemId), new { @class = "form-select product-select" })
                                        }
                                        else
                                        {
                                            @Html.DropDownListFor(m => m.OrderItems[i].ItemId,
                                                     new SelectList(ViewBag.Services, "Value", "Text", Model.OrderItems[i].ItemId), new { @class = "form-select product-select" })
                                        }
                                    </td>
                                    <td>
                                        @Html.TextBox($"OrderItems[{i}].UnitPrice", Model.OrderItems[i].UnitPrice, new { @class = "form-control", type = "number", placeholder = "Fiyat" })
                                    </td>
                                    <td>
                                        @Html.TextBox($"OrderItems[{i}].Quantity", Model.OrderItems[i].Quantity, new { @class = "form-control", type = "number", placeholder = "Miktar" })
                                    </td>
                                    <td>
                                        @Html.TextBox($"OrderItems[{i}].Note", Model.OrderItems[i].Note, new { @class = "form-control", type = "text", placeholder = "Not" })
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-danger btn-remove-item">Sil</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    <div class="row mb-3 mt-4">
                        <div class="col-12 text-center">
                            <button type="submit" class="btn btn-lg btn-primary me-2">Kaydet</button>

                            <a href="@Url.Action("Detail", "FinancialTracking", new { area = "Finance", Id = Model.CustomerId })"
                               class="btn btn-lg btn-secondary me-2">Geri Dön</a>

                            @if (Model.Id != 0)  // ID varsa (yeni ekleme değil düzenleme ise) silme butonu göster
                            {
                                <a href="@Url.Action("RemoveOrder", "FinancialTracking", new { area = "Finance", id = Model.Id, customerId = Model.CustomerId })"
                                   class="btn btn-lg btn-danger"
                                   onclick="return confirm('Bu siparişi silmek istediğinizden emin misiniz?')">
                                    Sil
                                </a>
                            }
                        </div>
                    </div>

                }
            </div>
        </div>
    </div>


</div>
<!-- Modal -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-labelledby="imageModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <!-- modal-lg ile büyük boy -->
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="imageModalLabel">Senet Fotoğrafı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body text-center">
                <img id="modalImage" src="" style="max-width: 100%; height: auto;" alt="Senet Fotoğrafı" />
            </div>
        </div>
    </div>
</div>
<script>
    let itemIndex = @initialItemCount;

    const productsOptionsHtml = `@Html.Raw(productsHtml)`;
    const servicesOptionsHtml = `@Html.Raw(servicesHtml)`;

              $('#btn-add-item').click(function () {
        let index = itemIndex;

        let template = `
    <tr class="order-item">
        <td>
            <input type="hidden" name="OrderItems[${index}].IsVisible" value="true" class="is-visible-field" />
            <select name="OrderItems[${index}].ItemType" class="form-select item-type-select">
                <option value="Product">Ürün</option>
                <option value="Service">Servis</option>
            </select>
        </td>
        <td>
            <select name="OrderItems[${index}].ItemId" class="form-select item-id-select">
                ${productsOptionsHtml}
            </select>
        </td>
        <td>
            <input type="number" name="OrderItems[${index}].UnitPrice" class="form-control" placeholder="Fiyat" />
        </td>
        <td>
            <input type="number" name="OrderItems[${index}].Quantity" class="form-control" value="1" placeholder="Miktar" />
        </td>
        <td>
            <input type="text" name="OrderItems[${index}].Note" class="form-control" placeholder="Not" />
        </td>
        <td>
            <button type="button" class="btn btn-danger btn-remove-item">Sil</button>
        </td>
    </tr>`;

        $('#order-items-container').prepend(template);
        itemIndex++;
    });

           $(document).on('click', '.btn-remove-item', function () {
        const row = $(this).closest('tr.order-item');
        row.hide(); // görünmez yap
        row.find('.is-visible-field').val('false'); // modelde IsVisible=false olur
        });



        $(document).on('change', '.item-type-select', function () {
        let container = $(this).closest('tr.order-item');
        let selectedType = $(this).val();
        let itemIdSelect = container.find('.item-id-select');

        if (selectedType === 'Product') {
            itemIdSelect.html(productsOptionsHtml);
        } else {
            itemIdSelect.html(servicesOptionsHtml);
        }
    });
      document.getElementById('ImageUrl').addEventListener('click', function () {
        var src = this.src;
        if(src) {
            var modalImg = document.getElementById('modalImage');
            modalImg.src = src;
            var myModal = new bootstrap.Modal(document.getElementById('imageModal'));
            myModal.show();
        }
    });
</script>


