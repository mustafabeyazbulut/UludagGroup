@model PaymentDetailViewModel

@{
    ViewData["Title"] = "Yeni Ödeme Ekle";
    Layout = "~/Areas/Finance/Views/FinanceLayout/Index.cshtml";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow rounded-4 border-0 mt-4">
            <div class="card-header bg-primary text-white rounded-top-4">
                <h4 class="mb-0"><i class="fa fa-plus me-2"></i>Yeni Ödeme Ekle</h4>
            </div>
            <div class="card-body">
                @using (Html.BeginForm(
                actionName: "SaveAddPayment",
                controllerName: "FinancialTracking",
                routeValues: new { area = "Finance" },
                method: FormMethod.Post,
                antiforgery: false,
                htmlAttributes: new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(x => x.Id)
                    @Html.HiddenFor(x => x.CustomerId)
                    @Html.HiddenFor(x => x.CustomerName)

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Firma Adı</label>
                        <div class="form-control bg-light">@Model.CustomerName</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Ödenen Miktar <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text">₺</span>
                            @Html.TextBoxFor(model => model.Amount, new
                                {
                                    @class = "form-control",
                                    type = "number",
                                    step = "0.01",
                                    min = "0",
                                    placeholder = "Ödenen miktarı girin"
                                })
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Not</label>
                        @Html.TextAreaFor(model => model.Notes, 3, 50, new
                            {
                                @class = "form-control",
                                placeholder = "Not girin (isteğe bağlı)..."
                            })
                    </div>

                    <div class="d-flex justify-content-center gap-3 mt-4">
                        <button type="submit" class="btn btn-success btn-lg">
                            <i class="fa fa-save me-1"></i> Kaydet
                        </button>
                        <a href="@Url.Action("Detail", "FinancialTracking", new { area = "Finance", Id = Model.CustomerId })" class="btn btn-secondary btn-lg">
                            <i class="fa fa-arrow-left me-1"></i> Geri Dön
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
