@model CustomerDebtViewModel
@{
    ViewData["Title"] = "Detail";
    Layout = "~/Areas/Finance/Views/FinanceLayout/Index.cshtml";
}
<style>
    .text-dark-yellow {
        color: #b58900 !important;
    }

    .text-dark-green {
        color: #228B22 !important;
    }

    .text-dark-red {
        color: #8B0000 !important;
    }

    .card-title,
    .list-group-item span,
    .card-text {
        font-size: 1.2rem;
    }

    .fw-bold {
        font-size: 1.25rem;
    }
</style>

<div class="container py-1">
    <div class="row g-4">
        <!-- Sol Bilgi Alanı -->
        <div class="col-lg-6">
            <div class="p-4 rounded-4 shadow-lg bg-light border-start border-5 border-primary">
                <h2 class="mb-3 text-primary fw-bold">
                    <i class="fa fa-user me-2"></i>@Model.Name
                </h2>

                <h5 class="mb-4 text-secondary">
                    <i class="fa fa-id-card me-2"></i>@Model.CName @Model.CSurname
                </h5>

                <div class="mb-3 d-flex justify-content-between border-bottom pb-2">
                    <span class="text-dark"><i class="fa fa-coins text-warning me-2"></i>Toplam Borç</span>
                    <span class="fw-bold text-warning">@Model.TotalDebt.ToString("N2", new CultureInfo("tr-TR")) ₺</span>
                </div>

                <div class="mb-3 d-flex justify-content-between border-bottom pb-2">
                    <span class="text-dark"><i class="fa fa-credit-card text-success me-2"></i>Toplam Ödenen</span>
                    <span class="fw-bold text-success">@Model.TotalPaid.ToString("N2", new CultureInfo("tr-TR")) ₺</span>
                </div>

                <div class="mb-3 d-flex justify-content-between border-bottom pb-2">
                    <span class="text-dark"><i class="fa fa-wallet text-danger me-2"></i>Kalan Bakiye</span>
                    <span class="fw-bold text-danger">@Model.RemainingBalance.ToString("N2", new CultureInfo("tr-TR")) ₺</span>
                </div>

                <p class="text-muted mt-4 small">
                    <i class="fa fa-info-circle me-1"></i> Detayları aşağıda inceleyebilirsiniz.
                </p>
            </div>
        </div>

        <!-- Sağ Butonlar -->
        <div class="col-lg-6 d-flex flex-column justify-content-center">
            <div class="d-grid gap-3">
                <a href="@Url.Action("Index", "FinancialTracking", new { area = "finance" })"
                   class="btn btn-dark btn-lg">
                    <i class="fa fa-arrow-left me-2"></i> Geri Dön
                </a>

                <a href="@Url.Action("EditCustomer", "FinancialTracking", new { area = "finance", id = Model.Id })"
                   class="btn btn-outline-primary btn-lg">
                    <i class="fa fa-edit me-2"></i> Düzenle
                </a>

                <a href="@Url.Action("RemoveCustomer", "FinancialTracking", new { area = "finance", id = Model.Id })"
                   class="btn btn-outline-danger btn-lg"
                   onclick="return confirm('Bu müşteriyi silmek istediğinize emin misiniz?');">
                    <i class="fa fa-trash me-2"></i> Sil
                </a>
            </div>
        </div>
    </div>
</div>
<hr />

<div id="ToolbarOrderDetail">
    <a href="@Url.Action("AddOrder", "FinancialTracking", new { area = "finance", customerid = Model.Id })" class="btn btn-success">
        <i class="fa fa-plus"></i> Yeni SATIŞ/SERVİS
    </a>

</div>
@await Component.InvokeAsync("_OrderDetail_ComponentPartial", new { id = Model.Id })


<hr />
<div id="ToolbarPaymentDetail">
    <a href="@Url.Action("AddPayment", "FinancialTracking", new { area = "finance", customerid = Model.Id })"
       class="btn btn-success"
       data-url="@Url.Action("AddPayment", "FinancialTracking", new { area = "finance", customerid = Model.Id })"
       id="btnAddPayment">
        <i class="fa fa-plus"></i> Yeni Ödeme
    </a>


</div>
@await Component.InvokeAsync("_PaymentDetail_ComponentPartial", new { id = Model.Id })

<div class="modal fade" id="modalAddPayment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- İçerik buraya AJAX ile gelecek -->
        </div>
    </div>
</div>
<div class="modal fade" id="modalAddPayment" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <!-- İçerik buraya AJAX ile gelecek -->
        </div>
    </div>
</div>

<script>
    $(document).on("click", "#btnAddPayment", function (e) {
        e.preventDefault();
        var url = $(this).data("url");
        $.get(url, function (data) {
            $("#modalAddPayment .modal-content").html(data);
            $("#modalAddPayment").modal("show");
        });
    });
</script>
