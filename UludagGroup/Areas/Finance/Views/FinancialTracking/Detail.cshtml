@model List<OrderDetailViewModel>
@{
    ViewData["Title"] = "Detail";
    Layout = "~/Areas/Finance/Views/FinanceLayout/Index.cshtml";
    var customerId = ViewContext.RouteData.Values["id"];
}
<div class="card shadow-sm">
    <div class="card-body">
        <h1 class="card-title">
            <i class="fa fa-building text-primary"></i> @ViewBag.CustomerName
        </h1>
        <p class="card-text">Sipariş detaylarını aşağıda inceleyebilirsiniz.</p>
    </div>
</div>
<style>
    /* Alternatif satır renkleri için */
    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f8f9fa;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #e9ecef;
    }

    .btn-action {
        width: 100px;
        margin-right: 5px;
    }

    .table th, .table td {
        vertical-align: middle;
    }
</style>

<div id="toolbar1">
    <a href="@Url.Action("AddOrder", "FinancialTracking", new { area = "finance", customerid = customerId })" class="btn btn-success">
        <i class="fa fa-plus"></i> Yeni Sipariş
    </a>

</div>
<table id="xTable"
       class="table table-striped"
       data-toolbar="#toolbar1"
       data-locale="tr-TR"
       data-toggle="table"
       data-show-fullscreen="true"
       data-search="true"
       data-pagination="true"
       data-page-size="10"
       data-mobile-responsive="true"
       data-animation="true"
       data-check-on-init="true"
       data-show-columns="true"
       data-detail-view="true"
       data-show-export="false"
       data-show-footer="true"
       data-detail-formatter="detailFormatter"
       data-minimum-count-columns="2"
       data-id-field="id"
       data-page-list="[10, 25, 50, 100, all]">
    <thead class="table-dark">
        <tr class="text-center">
            <th data-width="100" data-align="center" data-field="actions">İşlemler</th>
            <th data-width="120"  data-align="center" data-field="OrderDate">Tarih</th>
            <th data-align="center" data-field="OrderItems" data-visible="true">İçerik</th>
            <th data-align="center" data-field="Notes" data-visible="false">Not</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var order in Model)
        {
            <tr>
                <td class="text-center">
                    <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Seç
                    </button>
                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" href="@Url.Action("EditOrder", "FinancialTracking", new { area="finance", id = order.Id,customerId=order.CustomerId })">
                                <i class="fa fa-edit"></i> Düzenle
                            </a>
                        </li>
                        <li>
                            <a class="dropdown-item text-danger" href="@Url.Action("RemoveOrder", "FinancialTracking", new {area="finance", id = order.Id,customerId=order.CustomerId })" onclick="return confirm('Bu siparişi silmek istediğinizden emin misiniz?')">
                                <i class="fa fa-trash"></i> Sil
                            </a>
                        </li>
                    </ul>
                </td>

                <td>@order.OrderDate.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                <td>
                    <table id="xTable2" class="table table-striped table-responsive">
                        <thead class="table-dark">
                            <tr class="text-center">
                                <th >İşlemler</th>
                                <th >Tip</th>
                                <th>Adı</th>
                                <th>Not</th>
                                <th>Fiyat</th>
                                <th>Miktar</th>
                                <th>Toplam</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var orderItem in order.OrderItems)
                            {
                                <tr>
                                    <td class="text-center">
                                        <button class="btn btn-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            Seç
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li>
                                                <a class="dropdown-item text-danger" href="@Url.Action("RemoveOrderItem", "FinancialTracking", new { area="finance", id = orderItem.Id,customerId=order.CustomerId })" onclick="return confirm('Bu Sipariş Kalemini silmek istediğinizden emin misiniz?')">
                                                    <i class="fa fa-trash"></i> Sil
                                                </a>
                                            </li>
                                        </ul>
                                    </td>
                                    <td>
                                        @(orderItem.ItemType == "Service" ? "Hizmet" : orderItem.ItemType == "Product" ? "Ürün" : orderItem.ItemType)
                                    </td>
                                    <td>@orderItem.ItemName</td>
                                    <td>@orderItem.Note</td>
                                    <td>@orderItem.UnitPrice</td>
                                    <td>@orderItem.Quantity</td>
                                    <td>@orderItem.LineTotal</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </td>
                <td>@order.Notes</td>
            </tr>
        }
    </tbody>
</table>
<script>
        function detailFormatter(index, row) {
        var html = [];
        html.push('<p><strong>Not:</strong> ' + row.Notes + '</p>');

        // Burada siparişler ve ödemeler gibi diğer detayları da ekleyebilirsiniz.

        return html.join('');
    }

    function sumFormatter(data) {
        var field = this.field; // Bu kolonun adı: RemainingBalance
        var total = data.map(row => parseFloat(row[field]) || 0).reduce((sum, i) => sum + i, 0);
        return total.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
    }
         function total() {
        return "Toplam";
    }

</script>
