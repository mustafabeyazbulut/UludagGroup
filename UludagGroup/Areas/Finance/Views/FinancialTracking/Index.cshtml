@model List<CustomerDebtViewModel>

@{
    ViewData["Title"] = "Müşteri Listesi";
    Layout = "~/Areas/Finance/Views/FinanceLayout/Index.cshtml";
}

<style>
    /* Alternatif satır renkleri için */
    .table-striped tbody tr:nth-of-type(odd) {
        background-color: #f8f9fa;
    }

    .table-striped tbody tr:nth-of-type(even) {
        background-color: #e9ecef;
    }

    .btn-action {
        width: 100px;
        margin-right: 5px;
    }

    .table th, .table td {
        vertical-align: middle;
    }
</style>

<div id="toolbar">
    <a href="@Url.Action("AddCustomer", "FinancialTracking", new { area = "finance" })" class="btn btn-success">
        <i class="fa fa-plus"></i> Yeni Müşteri Ekle
    </a>
</div>

<table id="xTable"
       class="table table-striped"
       data-toolbar="#toolbar"
       data-locale="tr-TR"
       data-toggle="table"
       data-show-fullscreen="true"
       data-search="true"
       data-pagination="true"
       data-page-size="10"
       data-mobile-responsive="true"
       data-animation="true"
       data-check-on-init="true"
       data-show-columns="true"
       data-detail-view="true"
       data-show-export="true"
       data-show-footer="true"
       data-export-types="['excel']"
       data-detail-formatter="detailFormatter"
       data-minimum-count-columns="2"
       data-id-field="id"
       data-page-list="[10, 25, 50, 100, all]">
    <thead class="table-dark">
        <tr>
            <th data-align="center" data-halign="center" scope="col" data-field="Name" data-footer-formatter="total">Firma Adı</th>
            <th data-align="center" data-halign="center" scope="col" data-field="CName" data-footer-formatter="total">Müşteri Adı</th>
            <th data-align="center" data-halign="center" scope="col" data-field="CSurname" data-footer-formatter="total">Müşteri Soyad</th>
            <th data-align="center" data-halign="center" scope="col" data-field="Phone1" data-visible="true">Telefon 1</th>
            <th data-align="center" data-halign="center" scope="col" data-field="Phone2" data-visible="true">Telefon 2</th>
            <th data-align="center" data-halign="center" scope="col" data-field="Email" data-visible="false">Email</th>
            <th data-align="center" data-halign="center" scope="col" data-field="TotalDebt" data-visible="true">Toplam Borç</th>
            <th data-align="center" data-halign="center" scope="col" data-field="TotalPaid" data-visible="true">Ödenen Tutar</th>
            <th data-align="center" data-halign="center" scope="col" data-field="RemainingBalance" data-footer-formatter="sumFormatter">Kalan Bakiye</th>
            <th data-align="center" data-halign="center" scope="col" data-field="City" data-visible="true">Şehir</th>
            <th data-align="center" data-halign="center" scope="col" data-field="District" data-visible="true">İlçe</th>
            <th data-align="center" data-halign="center" scope="col" data-field="Address" data-visible="true">Address</th>
            <th data-align="center" data-halign="center" scope="col" data-field="Note" data-visible="false">Not</th>
            <th data-align="center" data-halign="center" scope="col" data-field="Phone3" data-visible="false">Telefon 3</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var customer in Model)
        {
            string rawPhone1 = customer.Phone1;
            string formattedPhone1 = rawPhone1?.Length == 11
            ? string.Format("0 ({0}) {1} {2} {3}",
            rawPhone1.Substring(1, 3),
            rawPhone1.Substring(4, 3),
            rawPhone1.Substring(7, 2),
            rawPhone1.Substring(9, 2))
            : rawPhone1;

            string rawPhone2 = customer.Phone2;
            string formattedPhone2 = rawPhone2?.Length == 11
            ? string.Format("0 ({0}) {1} {2} {3}",
            rawPhone2.Substring(1, 3),
            rawPhone2.Substring(4, 3),
            rawPhone2.Substring(7, 2),
            rawPhone2.Substring(9, 2))
            : rawPhone2;

            string rawPhone3 = customer.Phone3;
            string formattedPhone3 = rawPhone3?.Length == 11
            ? string.Format("0 ({0}) {1} {2} {3}",
            rawPhone3.Substring(1, 3),
            rawPhone3.Substring(4, 3),
            rawPhone3.Substring(7, 2),
            rawPhone3.Substring(9, 2))
            : rawPhone3;
            <tr class="clickable-row" data-href="@Url.Action("Detail", "FinancialTracking", new { area = "finance", id = customer.Id })">
                <td>@customer.Name</td>
                <td>@customer.CName</td>
                <td>@customer.CSurname</td>
                <td>
                    <a href="tel:@rawPhone1" class="text-decoration-none text-primary">@formattedPhone1</a>
                </td>
                <td>
                    <a href="tel:@rawPhone2" class="text-decoration-none text-primary">@formattedPhone2</a>
                </td>
                <td>@customer.Email</td>
                <td>@customer.TotalDebt.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                <td>@customer.TotalPaid.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                <td>@customer.RemainingBalance.ToString("N2", new CultureInfo("tr-TR")) ₺</td>
                <td>@customer.City</td>
                <td>@customer.District</td>
                <td>@customer.Address</td>
                <td>@customer.Note</td>
                <td>
                    <a href="tel:@rawPhone1" class="text-decoration-none text-primary">@formattedPhone3</a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script>
        function detailFormatter(index, row) {
        var html = [];
        html.push('<p><strong>Adı:</strong> ' + row.Name + '</p>');
        html.push('<p><strong>Şehir:</strong> ' + row.City + '</p>');
        html.push('<p><strong>İlçe:</strong> ' + row.District + '</p>');
        html.push('<p><strong>Adres:</strong> ' + row.Address + '</p>');
        html.push('<p><strong>Not:</strong> ' + row.Note + '</p>');
        html.push('<p><strong>Telefon1:</strong> ' + row.Phone1 + '</p>');
        html.push('<p><strong>Telefon2:</strong> ' + row.Phone2 + '</p>');
        html.push('<p><strong>Telefon3:</strong> ' + row.Phone3 + '</p>');
        html.push('<p><strong>Email:</strong> ' + row.Email + '</p>');
        html.push('<p><strong>Toplam Borç:</strong> ' + row.TotalDebt + '</p>');
        html.push('<p><strong>Ödenen Tutar:</strong> ' + row.TotalPaid + '</p>');
        html.push('<p><strong>Kalan Bakiye:</strong> ' + row.RemainingBalance + '</p>');

        // Burada siparişler ve ödemeler gibi diğer detayları da ekleyebilirsiniz.

        return html.join('');
    }

    function sumFormatter(data) {
        var field = this.field; // Bu kolonun adı: RemainingBalance
        var total = data.map(row => parseFloat(row[field]) || 0).reduce((sum, i) => sum + i, 0);
        return total.toLocaleString('tr-TR', { style: 'currency', currency: 'TRY' });
    }
         function total() {
        return "Toplam";
    }
       
   

</script>
