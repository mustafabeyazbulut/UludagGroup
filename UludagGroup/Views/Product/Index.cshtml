@model SearchProductViewModel
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/UILayout/Index.cshtml";
}
@await Component.InvokeAsync("_PageHeader_Generic_ComponentPartial", new { pageTitle = "Ürünlerimiz" })

<div class="container">
	<div class="section-title text-center mx-auto wow fadeInUp" data-wow-delay="0.1s" style="max-width: 500px;">
		<p class="fs-5 fw-medium fst-italic text-primary">Ürünlerimiz</p>
	</div>
	<div class="row">
		<div class="col-sm-3">
			@await Component.InvokeAsync("_Category_UIProduct_ComponentPartial", new { model = Model })
		</div>

		<div class="col-sm-9 padding-right">
			@await Component.InvokeAsync("_Main_UIProduct_ComponentPartial", new { model = Model })
		</div>
	</div>
</div>


